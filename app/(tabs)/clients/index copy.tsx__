import { ScrollView, StyleSheet, Text, View, FlatList, TouchableOpacity } from 'react-native'
import React, { useRef, useState, useMemo } from 'react'
import ScreenWrapper from '@/components/ScreenWrapper'
import SearchInput from '@/components/SearchInput'
import { ThemedText } from '@/components/ThemedText'
import { colors, Rs, SIZES } from '@/shared/utils'
import FlatBtn from '@/components/FlatBtn'
import ParallaxScrollView from '@/components/ParallaxScrollView'
import ClientItem from '@/features/dashboard/client/clients-item'
import { Link } from 'expo-router'
import BottomSheetCompoForm from '@/components/BottomSheetCompoForm'
import CustomInput from '@/components/form/CustomInput'
import { Feather } from '@expo/vector-icons'
import { BottomSheetModal } from '@gorhom/bottom-sheet'
import AddClient from '@/features/dashboard/client/add-client'
import EnhancedClientItem from '@/features/dashboard/client/clients-item'
import { useClients } from '@/hooks/app/useClient'
import { database } from '@/database/database'
import Client from '@/database/model/Client'
import { withObservables } from '@nozbe/watermelondb/react'
import { useSouscription } from '@/hooks/app/useSubscription'
import BottomSheetCompo from '@/components/BottomSheetCompo'
import BackButton from '@/components/BackButton'
import { Q } from '@nozbe/watermelondb'
import SubscriptionEmptyPay from '@/features/subscription/subscription-empty-pay'
import Souscription from '@/database/model/Souscription'
import Kit from '@/database/model/Kit'


type Props = {
  clients?: Client[]
  kits?: Kit[]
  subscriptions?: any[] // Add proper type based on your Subscription model
}

const Page = ({clients, kits, subscriptions}: Props) => {
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedKitId, setSelectedKitId] = useState<string | null>(null);
  const bottomSheetModalRef = useRef<BottomSheetModal>(null);
  
  // Get unique kits from subscriptions and match with kit details
  const availableKits = useMemo(() => {
    if (!subscriptions || !kits) return [];
    
    const uniqueKitIds = [...new Set(subscriptions.map((sub: Souscription) => sub.kitId))];
    // console.log("+++++++++++++++++++++++++++++", uniqueKitIds)
    return kits.filter(kit => uniqueKitIds.includes(kit.id));
  }, [subscriptions, kits]);

  // Filter clients based on search query and selected kit
  const filteredClients = useMemo(() => {
    if (!clients) return [];
    
    let filtered = clients.filter(client =>
      client.firstName?.toLowerCase().includes(searchQuery.toLowerCase()) ||
      client.lastName?.toLowerCase().includes(searchQuery.toLowerCase()) ||
      client.phone?.includes(searchQuery)
    );

    // If a kit is selected, filter by clients who have subscriptions to that kit
    if (selectedKitId && subscriptions) {
      console.log('IIIII')
      const clientIdsWithSelectedKit = subscriptions
        .filter(sub => sub.kit_id === selectedKitId)
        .map(sub => sub.client_id);
      
      filtered = filtered.filter(client => 
        clientIdsWithSelectedKit.includes(client.id)
      );
    }

    return filtered;
  }, [clients, searchQuery, selectedKitId, subscriptions]);

  const renderKitItem = ({ item }: { item: Kit }) => (
    <TouchableOpacity
      style={[
        styles.kitItem,
        selectedKitId === item.id && styles.selectedKitItem
      ]}
      onPress={() => {
        // console.log("+++++++++++++++++++++++++++++", item.id)
        setSelectedKitId(selectedKitId === item.id ? null : item.id);
      }}
    >
      <Text style={[
        styles.kitText,
        selectedKitId === item.id && styles.selectedKitText
      ]}>
        {item.label}
      </Text>
    </TouchableOpacity>
  );

  return (
    <>
    <ScreenWrapper>
      <SearchInput 
        placeholder="Rechercher un client" 
        searchQuery={searchQuery} 
        setSearchQuery={setSearchQuery} 
      />
   
      {/* Kits Filter List */}
      {availableKits.length > 0 && (
        <View style={styles.kitsContainer}>
          <FlatList
            data={availableKits}
            renderItem={renderKitItem}
            keyExtractor={(item) => item.id}
            horizontal
            showsHorizontalScrollIndicator={false}
            contentContainerStyle={styles.kitsList}
          />
        </View>
      )}

      <FlatBtn action={() => bottomSheetModalRef.current?.present()} />

      <ScrollView 
        style={{marginTop: Rs(20)}}
        snapToAlignment="start"
        decelerationRate="fast"
        bounces={false}
        keyboardShouldPersistTaps="handled"
        contentContainerStyle={{ gap: Rs(20), paddingBottom: Rs(20)}} 
        showsVerticalScrollIndicator={false}
      >
        {filteredClients?.map((item) => (
          <EnhancedClientItem key={item?.id} client={item} />
        ))}

        {filteredClients?.length === 0 && (
          <SubscriptionEmptyPay 
            title={selectedKitId ? 'Aucun client trouvé pour ce kit' : 'Aucun client enregistré'} 
            icon='👤'
          />
        )}
      </ScrollView>
    </ScreenWrapper>

    <BottomSheetCompo bottomSheetModalRef={bottomSheetModalRef} snapPoints={["90%"]}>
      <View style={{position: "absolute", top: Rs(15), right: Rs(20), zIndex: 1}}>
        <BackButton
          backAction={() => bottomSheetModalRef.current?.close()}
          icon={<Feather size={Rs(18)} name="x" color={colors.red} />}
        />
      </View>
      <AddClient closeModal={() => bottomSheetModalRef.current?.close()} />
    </BottomSheetCompo>
    </>
  )
}

const enhance = withObservables([], () => ({
  clients: database.get('clients')
    .query(
      Q.sortBy('created_at', Q.desc),
    )
    .observeWithColumns(['firstName', 'lastName', 'phone']),
  
  // Add kits query - adjust table name as needed
  kits: database.get('kits')
    .query()
    .observe(),
  
  // Add subscriptions query - adjust table name as needed
  subscriptions: database.get('souscriptions')
    .query()
    .observe()
}))

const EnhancedPage = enhance(Page)

export default EnhancedPage

const styles = StyleSheet.create({
  kitsContainer: {
    marginTop: Rs(15),
    marginBottom: Rs(10),
  },
  kitsList: {
    paddingHorizontal: Rs(20),
    gap: Rs(10),
  },
  kitItem: {
    paddingHorizontal: Rs(16),
    paddingVertical: Rs(8),
    borderRadius: Rs(20),
    backgroundColor: colors.lightGray || '#f0f0f0',
    borderWidth: 1,
    borderColor: colors.border || '#e0e0e0',
  },
  selectedKitItem: {
    backgroundColor: colors.primary || '#007AFF',
    borderColor: colors.primary || '#007AFF',
  },
  kitText: {
    fontSize: Rs(14),
    color: colors.text || '#333',
    fontWeight: '500',
  },
  selectedKitText: {
    color: '#fff',
  },
})